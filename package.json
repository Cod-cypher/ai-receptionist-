{
  "name": "ai-towing-receptionist",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant AI receptionist for towing companies. Never miss a towing lead again.",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/dashboard"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "npm run build -w @towai/shared && npm run build -w @towai/api",
    "test": "npm run test -w @towai/shared && npm run test -w @towai/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate": "npm run migrate -w @towai/api",
    "seed": "npm run seed -w @towai/api",
    "dev:api": "npm run start:dev -w @towai/api",
    "dev:dashboard": "npm run start -w @towai/dashboard",
    "simulate:call": "npm run simulate:call -w @towai/api"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public base URL of this API. Telephony webhooks and media-stream callbacks are
# built from it, so it must be reachable from the internet (use a tunnel in dev).
PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The application connects as towai_app, which is NOT the table owner. Postgres
# lets table owners bypass row-level security, so pointing this at the owner
# would silently disable every tenant-isolation policy.
DATABASE_URL=postgres://towai_app:towai_app@localhost:5433/towai
# Migrations run as the owner, which creates the tables, the policies and the
# towai_app role itself.
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5433/towai

REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# anthropic | openai | stub
# "stub" is deterministic and needs no key: the whole pipeline (call -> lead ->
# WhatsApp) runs offline against it, which is what the tests use.
AI_PROVIDER=stub

ANTHROPIC_API_KEY=
AI_ANTHROPIC_EXTRACTION_MODEL=claude-opus-5
AI_ANTHROPIC_RESPONSE_MODEL=claude-opus-5

OPENAI_API_KEY=
AI_OPENAI_EXTRACTION_MODEL=gpt-4o
AI_OPENAI_RESPONSE_MODEL=gpt-4o

# Any OpenAI-compatible gateway: OpenRouter, Together, Groq, a local vLLM.
# Leave unset for OpenAI itself.
#
# For OpenRouter, set AI_PROVIDER=openai and:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_API_KEY=sk-or-v1-...
#   AI_OPENAI_EXTRACTION_MODEL=openai/gpt-4o
#   AI_OPENAI_RESPONSE_MODEL=anthropic/claude-sonnet-4.5
#
# The extraction model MUST support strict json_schema structured outputs.
# Support varies by model on a gateway in a way it does not at OpenAI itself,
# and a model without it returns prose that fails validation, degrading every
# call to a callback request. The reply model has no such constraint — it only
# writes a sentence — so a cheap model there is a real saving.
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Telephony
# ---------------------------------------------------------------------------
# gather = TwiML <Gather>, Twilio does speech-to-text and text-to-speech.
#          Needs only Twilio credentials. ~2-3s per turn.
# stream = Twilio Media Streams + Deepgram + ElevenLabs. True barge-in,
#          ~1-1.5s per turn. Needs the extra keys below.
# chatgpt = Twilio Media Streams + one OpenAI realtime model that listens,
#          understands and speaks — the model runs the conversation and
#          saves details through backend tools, which validate them and decide
#          when a lead or callback is created. Needs only OPENAI_API_KEY.
VOICE_PIPELINE=gather

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set to false only for local testing without a tunnel. Never in production:
# it is what stops anyone POSTing fake calls to your webhook.
TWILIO_VALIDATE_SIGNATURE=true
# Voice used by <Say> on the gather pipeline.
TWILIO_TTS_VOICE=Polly.Joanna

# --- Speech for VOICE_PIPELINE=stream --------------------------------------
# Listening and speaking are chosen separately. Setting an OpenAI model selects
# OpenAI for that half (using OPENAI_API_KEY); otherwise Deepgram / ElevenLabs.
#
# OpenAI audio always goes to api.openai.com, even if OPENAI_BASE_URL points
# the language model at OpenRouter, which does not serve audio.
#
# Try any change without a phone call: npm run voice:check
AI_TRANSCRIPTION_MODEL=
# Silence (ms) that ends a caller's turn. Lower feels snappier; too low cuts
# callers off when they pause mid-sentence.
AI_TRANSCRIPTION_SILENCE_MS=600
AI_TTS_MODEL=
# alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse,
# marin, cedar. OpenAI recommends marin or cedar for quality.
AI_TTS_VOICE=marin
# How the voice should sound. Leave blank for the built-in calm receptionist.
AI_TTS_INSTRUCTIONS=

# --- VOICE_PIPELINE=chatgpt -------------------------------------------------
# Replaces AI_PROVIDER, AI_TRANSCRIPTION_MODEL and AI_TTS_MODEL on calls.
# Try it without a phone call: npm run realtime:check
AI_REALTIME_MODEL=gpt-realtime-mini
AI_REALTIME_VOICE=marin
# Pause (ms) that ends the caller's turn. 600 cut callers off mid-sentence on
# real calls; 900 lets them pause to think where they are.
AI_REALTIME_SILENCE_MS=900
# How the caller's turn is ended. server_vad: after AI_REALTIME_SILENCE_MS of
# quiet. semantic_vad: OpenAI also judges from the words whether the caller has
# finished ("it's near... um" waits), with AI_REALTIME_VAD_EAGERNESS
# low|medium|high|auto. Try semantic_vad on a real call if callers are cut off.
AI_REALTIME_TURN_DETECTION=server_vad
AI_REALTIME_VAD_EAGERNESS=auto
# OpenAI's input noise reduction: near_field (handset), far_field (speakerphone
# or car), or off. Without it road noise and breathing start caller turns.
AI_REALTIME_NOISE_REDUCTION=near_field
# Transcribes the caller for the call record (the realtime model hears the
# audio itself; this only feeds the transcript and dashboard).
AI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Optional: prices (USD per 1M tokens, from OpenAI's pricing page) so
# npm run realtime:eval can estimate cost. Leave blank for token counts only.
REALTIME_PRICE_TEXT_IN=
REALTIME_PRICE_CACHED_TEXT_IN=
REALTIME_PRICE_AUDIO_IN=
REALTIME_PRICE_CACHED_AUDIO_IN=
REALTIME_PRICE_TEXT_OUT=
REALTIME_PRICE_AUDIO_OUT=

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------------------
# WhatsApp
# ---------------------------------------------------------------------------
# twilio | console
# "console" logs the rendered notification instead of sending it — the default
# for development, and it exercises the identical formatting path.
WHATSAPP_PROVIDER=console
# Twilio sandbox number, or your approved WhatsApp sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Business-initiated messages outside the 24-hour service window require an
# approved template. Leave blank to send a plain body (sandbox only).
TWILIO_WHATSAPP_CONTENT_SID=

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
# Dev-only text simulator at POST /dev/conversations. Never enable in production.
ENABLE_DEV_SIMULATOR=true
